rules_version = '2';

// Members only (26 Sep 2026). Nothing is read without a signed-in account whose access
// document is active, except meta/settings, which the signed-out shell prints the team name
// from. Writes are role-based through the same access document.
//
// Firestore ORs every rule that matches a path, so a broad rule silently voids every stricter
// one beneath it: the old catch-all `match /{document=**} { allow read: if true; allow write:
// if canEdit(); }` made access, userPrefs, clientErrors, crawlState and crawlSeen world-readable
// and let a contributor write access (and so make themselves admin), meta/settings, anyone's
// userPrefs and the crawler's state, and edit or delete error reports. The root catch-all below
// therefore names the paths that have their own block and stays out of them: each path is
// decided by exactly one block. A new collection is still covered with no rules
// change (members read, editors write); a collection given a block of its own must also be
// added to ownBlock(), or the catch-all goes on granting what that block refuses.
//
// Another team's data (release 2, 27 Sep 2026) lives under teams/{teamId}: the same collection
// and meta names as the root, under a root document teams/{teamId}. 'teams' is in ownBlock(), so
// the root catch-all never reaches that tree, and the tree has a catch-all pair of its own with
// teamOwnBlock() as its ownBlock(). One membership list for every team in this release: the team
// blocks ask the same hasAccess(), canEdit() and isAdmin() as the root; per-team access
// (teams/{teamId}/access) is release 3 and is refused everything until then.
//
// What the app must do in return, or these rules break sign-in rather than protect it:
// - Open no listener but meta/settings until AuthService has let the person in. A listen refused
//   while signed out ends for good (Firestore never retries it), so a listener opened on the login
//   page stays dead after sign-in until the page is reloaded. meta/settings is the exception
//   because it is public: the signed-out shell listens to it from the first paint.
// - Close every member listener on sign-out (meta/settings stays open) and open them again on the
//   next sign-in. Signing out re-sends each open listen without a token, each is refused, and the
//   signals keep the last account's data with nothing on screen saying it is stale.
// - Listen to the whole `access` collection only as an admin; anyone else is refused it.
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in through one of the app's two doors: Google (the login page) or a custom token (the
    // e2e runner's, minted from the service account). Membership rests on the token's email, so a
    // door that lets someone claim an address without proving it must not count here — an
    // Email/Password sign-up, an anonymous account given an email, any provider switched on later.
    // Google and the service account both vouch for the address; nothing else here does. A new way
    // to sign in to the app needs its provider added to this list, or its users get in and are
    // refused every read.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom'];
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function bootstrapAdmin() {
      return signedIn() && emailKey() in [
        'ruanhart7@gmail.com'
      ];
    }

    function hasAccessDoc() {
      return signedIn() && exists(/databases/$(database)/documents/access/$(emailKey()));
    }

    function accessData() {
      return get(/databases/$(database)/documents/access/$(emailKey())).data;
    }

    function accessRole() {
      return accessData().get('role', null);
    }

    // JavaScript truthiness, because that is the test the app applies: AuthService (resolveRole and
    // enforceAccess) signs a person out, and the functions' getAccessRoleByEmail refuses them, on
    // `!access.active || !access.role`. A stricter test here (say `active == true`) would lock out
    // someone the app lets in; a looser one would let someone the app turns away read with their
    // token. An absent field reads as null. (NaN is the one value JavaScript calls falsy that this
    // does not; nothing writes one.)
    function truthy(v) {
      return v != null
        && !(v is bool && v == false)
        && !(v is number && v == 0)
        && !(v is string && v == '');
    }

    // Signed in and let in by the app: the bootstrap admin, or an access document whose
    // `active` and `role` are both set. Every read of team data asks this.
    function hasAccess() {
      return bootstrapAdmin()
        || (hasAccessDoc() && truthy(accessData().get('active', null)) && truthy(accessRole()));
    }

    // Both roles now require an active entry. Unticking Active on Admin › Access takes a person's
    // writes away at once and their live reads at the next stream restart (a token refresh, at most
    // an hour, or a reconnect); the app then signs them out, on their next load or mid-session when
    // TeamDataService sees the refusals and AuthService.confirmAccess finds the entry inactive.
    // Before, an inactive contributor's token could still write everything the catch-all covers,
    // including (through it) access.
    function isAdmin() {
      return bootstrapAdmin() || (hasAccess() && accessRole() == 'admin');
    }

    function canEdit() {
      return bootstrapAdmin() || (hasAccess() && accessRole() in ['admin', 'contributor']);
    }

    // The collections decided by their own block below and never by the root catch-all. 'teams' is
    // the whole of another team's tree: the team document and everything under it are decided by the
    // teams blocks, and without this entry the root catch-all would go on granting what they refuse.
    function ownBlock(collectionId) {
      return collectionId in ['access', 'userPrefs', 'clientErrors', 'draftEvents', 'crawlState', 'crawlSeen', 'teams'];
    }

    // The teams tree's ownBlock(): the collections under teams/{teamId} decided by their own block
    // and never by the team catch-all. draftEvents has its block below; access has none yet, so it
    // is refused everything until release 3 gives a team its own membership list there.
    function teamOwnBlock(collectionId) {
      return collectionId in ['draftEvents', 'access'];
    }

    // Anyone signed in may read their OWN entry, active or not: AuthService reads it to decide
    // whether to let them in at all, before anything else, and must learn "inactive" rather than
    // hit a permission error. Listing the collection is for admins (Admin › Access, Download team
    // data). isAdmin() is asked first so an admin's list query never depends on the document id.
    match /access/{emailId} {
      allow read: if isAdmin() || (signedIn() && emailId == emailKey());
      allow create, update, delete: if isAdmin();
    }

    // Public on purpose: the shell listens to it from the first paint, and the signed-out topbar
    // and the Riot notice in the footer print its team name. Nothing else in it is personal: the
    // name, the motto, the banner champion, two switches and a patch date.
    match /meta/settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One person's tours, film progress and reading depth, keyed by their own lowercased email.
    // The app only touches it once AuthService has let that person in.
    match /userPrefs/{emailId} {
      allow read, write: if hasAccess() && emailId == emailKey();
    }

    // A member's browser may report an uncaught error; only an admin reads them (Admin ›
    // Diagnostics), and nobody edits or deletes one from the app.
    match /clientErrors/{id} {
      allow create: if hasAccess();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // The draft log (27 Sep 2026): one row per save of a series game and per deleted game
    // (TeamDataService.logDraftEvent, logDeletedGame), and `by` on every row is the saver's email.
    // The catch-all let every member list them, a viewer included, while the access list that holds
    // the same addresses is admin-only. The one reader is Admin › Diagnostics, an admin's tab. Editors
    // write them because every save of a game writes one. Update as well as create: a row's id is the
    // save's time to a tenth of a second plus the game's id and setDoc does not merge, so a second save
    // of one game inside the same tenth is an overwrite. Nothing in the app deletes a row.
    match /draftEvents/{id} {
      allow create, update: if canEdit();
      allow read: if isAdmin();
      allow delete: if false;
    }

    // The crawler's working state, not its output. crawlState holds a queue of up to 4,000 puuids
    // and crawlSeen a marker per match id — neither is of any use to a reader, and a list of
    // identifiers for players who never opted into anything must not leave the functions, which
    // write these through the admin SDK (it bypasses rules entirely).
    match /crawlState/{doc} {
      allow read, write: if false;
    }

    match /crawlSeen/{doc} {
      allow read, write: if false;
    }

    // Another team's tree (release 2, 27 Sep 2026). Bom Squad stays on the flat root; any other team
    // lives at teams/{teamId}/<collection> and teams/{teamId}/meta/<doc>, the same names, under the
    // team document. Before these blocks the two root catch-alls covered the whole tree, so a
    // contributor could write the team document and its meta/settings (the root's is admin-only) and
    // a viewer could list its draftEvents (the root's is admin-read). The blocks give the tree the
    // root's own terms and ask the root membership list: one list for every team in this release.
    //
    // The team document: every member reads it (the switcher lists teams); an admin creates it (one
    // batch with meta/settings and meta/resourceLinks) and deletes it (the same three, once the tree is
    // empty). Nothing in the app updates it: a rename is written to the team's own meta/settings.teamName
    // (Admin › Settings) and the name here is only the fallback; update stays admin-only so an edit by
    // hand needs no rules change. The functions write refreshStartedAt on it through the admin SDK,
    // which rules do not apply to, so no editor write. createdBy on it is the creating admin's email,
    // and every member reads it with the rest of the document: a read rule cannot hide a field, and the
    // switcher must list teams. Known and left there for now; the alternative is the email in a
    // subdocument only admins read (teams/{teamId}/meta/owner, with a block of its own and a
    // teamOwnBlock() entry), and which of the two stands is the lead's call (docs/handover-2026-09-27.md,
    // Stage 4).
    match /teams/{teamId} {
      allow read: if hasAccess();
      allow create, update, delete: if isAdmin();
    }

    // The team's settings: members only, no public read. The signed-out shell prints the ROOT name
    // from the root meta/settings, and nothing signed out needs a team's. Admin write, as at the root.
    match /teams/{teamId}/meta/settings {
      allow read: if hasAccess();
      allow write: if isAdmin();
    }

    // The team's draft log: the root block's twin, for the same reasons. Every row's `by` is a
    // teammate's email and the one reader is Admin › Diagnostics; editors write one on every save of
    // a game (update because two saves inside a tenth of a second share an id); nothing deletes one.
    match /teams/{teamId}/draftEvents/{id} {
      allow create, update: if canEdit();
      allow read: if isAdmin();
      allow delete: if false;
    }

    // Everything else under the team: members read, editors write, the root catch-all's terms. Out
    // of the collections in teamOwnBlock() and out of meta/settings, so each path is decided by
    // exactly one block. Two matches for the root's reason: the first covers the team's top-level
    // documents, the second anything in a subcollection of one.
    //
    // The string tests stand before hasAccess() and canEdit(), here and in the root pair: && stops at
    // the first false, so a path a block refuses costs no read of the access document. That matters
    // because a write to a team's meta/settings matches three blocks (its own, this one and the root
    // subcollection catch-all, which matches every path of three segments or more), and each
    // hasAccess() or canEdit() is up to four get/exists calls when nothing is cached, against
    // Firestore's limit of ten per evaluation and per operation of a batch. Firestore says a repeated
    // read of one document MAY be cached, and neither rules-check (mocked calls) nor the dry-run can
    // measure that; with the tests first the uncached worst case is four calls, not twelve.
    match /teams/{teamId}/{collectionId}/{docId} {
      allow read: if !teamOwnBlock(collectionId)
        && !(collectionId == 'meta' && docId == 'settings')
        && hasAccess();
      allow write: if !teamOwnBlock(collectionId)
        && !(collectionId == 'meta' && docId == 'settings')
        && canEdit();
    }

    match /teams/{teamId}/{collectionId}/{docId}/{subcollectionId}/{rest=**} {
      allow read: if !teamOwnBlock(collectionId) && hasAccess();
      allow write: if !teamOwnBlock(collectionId) && canEdit();
    }

    // Everything else at the root: members read, editors write. That includes championStats, matchupIndex and
    // the rest of meta, which the app reads only behind the viewer guard. Another team's tree is not
    // covered here: 'teams' is in ownBlock() and the teams blocks above decide it. The scripts, including
    // scripts/dev-timeline.mjs (players and matchCache), read through firebase-admin with the
    // service account, which rules do not apply to. The function-written collections (gameReviews,
    // matchCache, matchTimeline, rankHistory, replayRecordings, replayShots, meta/compAnalysis …)
    // are still editor-writable here, as they always were; the functions write them through the
    // admin SDK, which rules do not apply to.
    //
    // Two matches rather than `{document=**}`: a recursive wildcard binds a path, and meta/settings
    // has to be told apart from the rest of meta by comparing two plain strings. The first covers
    // every top-level document, the second anything in a subcollection. The string tests come first
    // for the reason given on the team pair: the second match here also reaches every teams path, and
    // with !ownBlock() first that costs it no read of the access document.
    match /{collectionId}/{docId} {
      allow read: if !ownBlock(collectionId)
        && !(collectionId == 'meta' && docId == 'settings')
        && hasAccess();
      allow write: if !ownBlock(collectionId)
        && !(collectionId == 'meta' && docId == 'settings')
        && canEdit();
    }

    match /{collectionId}/{docId}/{subcollectionId}/{rest=**} {
      allow read: if !ownBlock(collectionId) && hasAccess();
      allow write: if !ownBlock(collectionId) && canEdit();
    }
  }
}
