rules_version = '2';

// Public read for the app; role-based writes are controlled through access docs.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function bootstrapAdmin() {
      return signedIn() && emailKey() in [
        'ruanhart7@gmail.com'
      ];
    }

    function hasAccessDoc() {
      return signedIn() && exists(/databases/$(database)/documents/access/$(emailKey()));
    }

    function accessRole() {
      return get(/databases/$(database)/documents/access/$(emailKey())).data.role;
    }

    function isAdmin() {
      return bootstrapAdmin() || (hasAccessDoc() && accessRole() == 'admin');
    }

    function canEdit() {
      return bootstrapAdmin() || (hasAccessDoc() && (accessRole() == 'admin' || accessRole() == 'contributor'));
    }

    match /access/{emailId} {
      allow read: if signedIn() && (bootstrapAdmin() || isAdmin() || emailId == emailKey());
      allow create, update, delete: if isAdmin();
    }

    match /meta/settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userPrefs/{emailId} {
      allow read, write: if signedIn() && emailId == emailKey();
    }

    // The crawler's working state, not its output. crawlState holds a queue of
    // up to 4,000 puuids and crawlSeen a marker per match id — neither is of any
    // use to a reader, and the catch-all below would otherwise publish a list of
    // identifiers for players who never opted into anything. The functions write
    // these through the admin SDK, which bypasses rules entirely.
    //
    // The aggregate counters in championStats stay public: they are champion
    // totals with no player in them, which is the whole point of the collection.
    match /crawlState/{doc} {
      allow read, write: if false;
    }

    match /crawlSeen/{doc} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if canEdit();
    }
  }
}
